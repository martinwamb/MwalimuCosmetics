### Frontend Code

Next, let's create a simple React component to interact with the backend API:

```jsx
import React, { useState, useEffect } from 'react';
import axios from 'axios';

const MirrorControl = () => {
  const [isMirroring, setIsMirroring] = useState(false);

  useEffect(() => {
    // Fetch initial state from server
    axios.get('http://localhost:3000/mirror/state')
      .then(response => {
        setIsMirroring(response.data.isMirroring);
      })
      .catch(error => console.error('Error fetching mirror state:', error));
  }, []);

  const startMirror = () => {
    axios.post('http://localhost:3000/mirror/start')
      .then(() => setIsMirroring(true))
      .catch(error => console.error('Error starting mirror:', error));
  };

  const stopMirror = () => {
    axios.post('http://localhost:3000/mirror/stop')
      .then(() => setIsMirroring(false))
      .catch(error => console.error('Error stopping mirror:', error));
  };

  return (
    <div>
      {isMirroring ? 'Database Mirroring is ON' : 'Database Mirroring is OFF'}
      <button onClick={startMirror} disabled={isMirroring}>Start Mirror</button>
      <button onClick={stopMirror} disabled={!isMirroring}>Stop Mirror</button>
    </div>
  );
};

export default MirrorControl;
```

