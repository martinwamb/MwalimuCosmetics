generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  role          Role
  passwordHash  String
  biometricRef  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  salesOrders   SalesOrder[] @relation("SalesUser")
  clockings     Clocking[]
  mailMessages  MailMessage[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  brand       String?
  sku         String   @unique
  slug        String?  @unique
  shortDescription String? @db.VarChar(160)
  description String?
  featured    Boolean  @default(false)
  imageUrl    String?
  galleryImages String[] @db.Text
  category    Category? @relation(fields: [categoryId], references: [id])
  categoryId  String?
  price          Decimal  @db.Decimal(12, 2)
  wholesalePrice Decimal? @db.Decimal(12, 2)
  specialPrice   Decimal? @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  currency    String   @default("KES")
  cost        Decimal  @db.Decimal(12, 2)
  stockQty    Int      @default(0)
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       SalesOrderItem[]
  purchaseItems PurchaseItem[]
  priceWatch  PriceWatch[]
  recommendations AiRecommendation[] @relation("ProductRecommendations")
  inventoryMovements InventoryMovement[]
  variants    ProductVariant[]
  productTags ProductTag[]
}

model ProductVariant {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String?
  price     Decimal? @db.Decimal(12, 2)
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  createdAt DateTime @default(now())
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model TagGroup {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  selection   TagSelection
  required    Boolean      @default(false)
  editable    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tags        Tag[]
}

model Tag {
  id        String   @id @default(cuid())
  value     String
  label     String
  isSystem  Boolean  @default(false)
  sortOrder Int      @default(0)
  group     TagGroup @relation(fields: [groupId], references: [id])
  groupId   String
  products  ProductTag[]

  @@unique([groupId, value])
}

model ProductTag {
  product   Product @relation(fields: [productId], references: [id])
  productId String
  tag       Tag     @relation(fields: [tagId], references: [id])
  tagId     String
  createdAt DateTime @default(now())

  @@id([productId, tagId])
}

model Customer {
  id        String     @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  marketingOptIn Boolean @default(false)
  loyalty   Int        @default(0)
  orders    SalesOrder[]
  createdAt DateTime   @default(now())
}

model SalesOrder {
  id             String          @id @default(cuid())
  channel        OrderChannel
  status         OrderStatus     @default(PENDING)
  customer       Customer?       @relation(fields: [customerId], references: [id])
  customerId     String?
  createdBy      User?           @relation("SalesUser", fields: [createdById], references: [id])
  createdById    String?
  paymentStatus  PaymentStatus   @default(UNPAID)
  paymentMethod  PaymentMethod?
  subtotal       Decimal         @db.Decimal(12, 2)
  tax            Decimal         @db.Decimal(12, 2) @default(0)
  discount       Decimal         @db.Decimal(12, 2) @default(0)
  total          Decimal         @db.Decimal(12, 2)
  createdAt      DateTime        @default(now())
  items          SalesOrderItem[]
  payments       Payment[]
}

model SalesOrderItem {
  id        String   @id @default(cuid())
  order     SalesOrder @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  qty       Int
  unitPrice Decimal  @db.Decimal(12, 2)
  discount  Decimal  @db.Decimal(12, 2) @default(0)
  tax       Decimal  @db.Decimal(12, 2) @default(0)
}

model Payment {
  id          String        @id @default(cuid())
  order       SalesOrder    @relation(fields: [orderId], references: [id])
  orderId     String
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?
  txnTime     DateTime      @default(now())
  reconciled  Boolean       @default(false)
  gatewayMeta Json?
  bankReconciliations BankReconciliation[]
}

model Purchase {
  id          String     @id @default(cuid())
  supplier    Supplier   @relation(fields: [supplierId], references: [id])
  supplierId  String
  totalCost   Decimal    @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime   @default(now())
  items       PurchaseItem[]
}

model PurchaseItem {
  id         String    @id @default(cuid())
  purchase   Purchase  @relation(fields: [purchaseId], references: [id])
  purchaseId String
  product    Product   @relation(fields: [productId], references: [id])
  productId  String
  qty        Int
  cost       Decimal   @db.Decimal(12, 2)
}

model Supplier {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  purchases Purchase[]
}

model InventoryMovement {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  delta      Int
  reason     String
  createdAt  DateTime @default(now())
}

model BankAccount {
  id        String    @id @default(cuid())
  name      String
  balance   Decimal   @db.Decimal(14, 2)
  statements BankStatement[]
}

model BankStatement {
  id            String    @id @default(cuid())
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  bankAccountId String
  description   String
  amount        Decimal   @db.Decimal(12, 2)
  txnDate       DateTime
  reconciliations BankReconciliation[]
}

model BankReconciliation {
  id             String       @id @default(cuid())
  statementLine  BankStatement @relation(fields: [statementId], references: [id])
  statementId    String
  payment        Payment?     @relation(fields: [paymentId], references: [id])
  paymentId      String?
  status         ReconciliationStatus @default(UNMATCHED)
  notes          String?
  createdAt      DateTime @default(now())
}

model PriceWatch {
  id         String    @id @default(cuid())
  product    Product   @relation(fields: [productId], references: [id])
  productId  String
  marketPrice Decimal  @db.Decimal(12, 2)
  source     String
  checkedAt  DateTime  @default(now())
}

model AiRecommendation {
  id         String    @id @default(cuid())
  type       RecommendationType
  payload    Json
  status     RecommendationStatus @default(PENDING)
  createdAt  DateTime  @default(now())
  product    Product?  @relation("ProductRecommendations", fields: [productId], references: [id])
  productId  String?
}

model Clocking {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  timeIn    DateTime
  timeOut   DateTime?
  deviceRef String?
}

model MailMessage {
  id        String        @id @default(cuid())
  to        String
  from      String
  subject   String?
  body      String?
  direction MailDirection @default(OUTBOUND)
  status    MailStatus    @default(SENT)
  user      User?         @relation(fields: [userId], references: [id])
  userId    String?
  createdAt DateTime      @default(now())
}

enum Role {
  CUSTOMER
  SALES
  ACCOUNTS
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrderChannel {
  ONLINE
  COUNTER
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CARD
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
}

enum ReconciliationStatus {
  UNMATCHED
  MATCHED
  REVIEW
}

enum RecommendationType {
  PRICE_GAP
  SLOW_MOVER_DISCOUNT
  SEASONAL_STOCK
}

enum RecommendationStatus {
  PENDING
  APPROVED
  APPLIED
  DISMISSED
}

enum MailDirection {
  INBOUND
  OUTBOUND
}

enum MailStatus {
  QUEUED
  SENT
  FAILED
}

model HomepageBanner {
  id        String   @id @default(cuid())
  title     String
  subtext   String?
  ctaText   String?
  ctaLink   String?
  imageUrl  String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomepageSection {
  id        String              @id @default(cuid())
  type      HomepageSectionType
  title     String
  subtitle  String?
  enabled   Boolean             @default(true)
  sortOrder Int                 @default(0)
  queryType HomepageRuleType?
  queryValue String?
  maxItems  Int                 @default(8)
  sortBy    HomepageSort        @default(NEWEST)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  items     HomepageSectionItem[]
}

model HomepageSectionItem {
  id         String            @id @default(cuid())
  section    HomepageSection   @relation(fields: [sectionId], references: [id])
  sectionId  String
  label      String
  imageUrl   String?
  linkType   HomepageLinkType  @default(URL)
  linkTarget String?
  badge      String?
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

enum HomepageSectionType {
  CATEGORY
  NEED
  FEATURED_COLLECTION
  BEST_SELLERS
  PRICE
  NEW_ARRIVALS
  BIG_SAVINGS
}

enum HomepageLinkType {
  URL
  CATEGORY
  PRODUCT
  FILTER
}

enum HomepageRuleType {
  MARKETING_TAG
  CARE_AREA
  PRODUCT_TYPE
  BENEFIT
  PRICE_BUCKET
  SPECIAL
}

enum HomepageSort {
  NEWEST
  PRICE_ASC
  PRICE_DESC
  BEST_SELLING
}

enum TagSelection {
  SINGLE
  MULTI
}
