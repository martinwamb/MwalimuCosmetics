bridge/orphans-output/
bridge/diagnose-output/

# Ticket QR pool — 900 generated PNGs, ~2.4MB, rebuilt in five seconds by
# bridge/tickets/make-qr.js. They are deployment artefacts, not source, and
# they have to be regenerated anyway if the bot is ever renamed.
bridge/tickets/qr/
bridge/tickets/logs/
bridge/tickets/telegram-offset.txt

# Rights snapshots taken before a change, so one can be undone. Point-in-time
# operational data about who could do what, not source — same reasoning as the
# audit output above: it belongs on the machine that produced it.
bridge/rights-backup/
