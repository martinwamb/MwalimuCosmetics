# Backend auth defaults
ADMIN_EMAIL=admin@mwalimu.com
ADMIN_PASSWORD=change-me-now

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mwalimu

# JWT
JWT_SECRET=replace-with-strong-secret

# Frontend API base (Next.js)
NEXT_PUBLIC_API_URL=https://api.mwalimucosmetics.com
PASSWORD_RESET_URL=https://mwalimucosmetics.com/reset-password

# Outbound email (SMTP)
MAIL_FROM=notifications@mwalimucosmetics.com
SMTP_HOST=smtp.mail.mwalimucosmetics.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@mwalimucosmetics.com
SMTP_PASS=change-me

# Optional inbound fetch (IMAP/POP3) for future syncs
IMAP_HOST=mail.mwalimucosmetics.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=notifications@mwalimucosmetics.com
IMAP_PASS=change-me
