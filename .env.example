# Backend auth defaults
ADMIN_EMAIL=wambugujusk@gmail.com
ADMIN_PASSWORD=change-me-now

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mwalimu

# JWT
JWT_SECRET=replace-with-strong-secret

# Frontend base (used for OAuth + WebAuthn redirects)
FRONT_BASE_URL=https://mwalimucosmetics.com

# Social sign-in (OAuth)
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
FACEBOOK_APP_ID=replace-with-facebook-app-id
FACEBOOK_APP_SECRET=replace-with-facebook-app-secret

# WebAuthn
WEBAUTHN_RP_ID=mwalimucosmetics.com
WEBAUTHN_ORIGIN=https://mwalimucosmetics.com

# Frontend API base (Next.js)
NEXT_PUBLIC_API_URL=https://api.mwalimucosmetics.com
PASSWORD_RESET_URL=https://mwalimucosmetics.com/reset-password
NEXT_PUBLIC_ORDER_EMAIL=orders@example.com
NEXT_PUBLIC_ORDER_WHATSAPP=+254700000000
NEXT_PUBLIC_ORDER_TELEGRAM=mwalimuorders
ORDER_EMAIL=orders@example.com
WHATSAPP_TOKEN=replace-with-wa-cloud-token
WHATSAPP_PHONE_ID=1234567890
ORDER_WHATSAPP_TO=254700000000
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_CHAT_ID=123456789
STORE_BASE_URL=https://mwalimucosmetics.com/products

# Outbound email (SMTP) - replace with real credentials in deployment env only
MAIL_FROM=notifications@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASS=replace-me

# Optional inbound fetch (IMAP/POP3) for future syncs
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=notifications@example.com
IMAP_PASS=replace-me
